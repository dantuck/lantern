{
  "name": "family-dashboard",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  // Reachable ONLY on your own domain: no *.workers.dev URL and no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // Template: your untracked wrangler.jsonc is copied from this (npm run init). Replace with your real hostname before deploying (see README). It must match APP_ORIGIN below.
  "routes": [{ "pattern": "dashboard.example.com", "custom_domain": true }],
  // Privacy defaults. Nothing here reports to the project author; these keep Cloudflare's tooling quiet too.
  // Logs: off. Turn on ("enabled": true) only while debugging; they are stored in YOUR Cloudflare account and can
  // include sign-in addresses and plugin errors.
  "observability": { "enabled": false },
  // No usage metrics or dependency inventory sent from wrangler.
  "send_metrics": false,
  "dependencies_instrumentation": { "enabled": false },
  "assets": { "binding": "ASSETS", "directory": "./dist", "html_handling": "none" },
  "d1_databases": [
    { "binding": "DB", "database_name": "family-dashboard", "database_id": "REPLACE_AFTER_d1_create" }
  ],
  "kv_namespaces": [
    { "binding": "CACHE" }
  ],
  "vars": {
    "APP_ORIGIN": "http://localhost:4321",
    "MAIL_FROM": "Family Dashboard <login@example.com>"
  }
  // Secrets (wrangler secret put): RESEND_API_KEY, BOOTSTRAP_MANAGER_EMAIL,
  // GOOGLE_SERVICE_ACCOUNT_JSON, MEALQ_API_TOKEN
}
