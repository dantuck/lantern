{
  "name": "lantern",
  "type": "module",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/dantuck/lantern.git"
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "version": "0.18.0",
  "scripts": {
    "init": "node scripts/init-config.mjs",
    "setup": "node scripts/setup.mjs",
    "update": "node scripts/update.mjs",
    "doctor": "node scripts/doctor.mjs",
    "push:keys": "node scripts/push-keys.mjs",
    "migrations:seal": "node scripts/seal-migrations.mjs",
    "postinstall": "node scripts/init-config.mjs",
    "predev": "node scripts/init-config.mjs",
    "prebuild": "node scripts/init-config.mjs",
    "pretest": "node scripts/init-config.mjs",
    "precheck": "node scripts/init-config.mjs",
    "preverify": "node scripts/init-config.mjs",
    "dev": "node scripts/run.mjs astro dev",
    "build": "node scripts/run.mjs astro build",
    "preview": "node scripts/run.mjs wrangler dev",
    "check": "node scripts/run.mjs astro check",
    "test": "vitest run",
    "db:migrate:local": "node scripts/run.mjs wrangler d1 migrations apply lantern --local",
    "db:migrate:remote": "node scripts/run.mjs wrangler d1 migrations apply lantern --remote",
    "verify": "vitest run && npm run check && npm run build && bash scripts/check-bundle.sh && node scripts/audit.mjs",
    "verify:e2e": "bash scripts/smoke-admin.sh && bash scripts/smoke-plugins.sh && bash scripts/check-csp.sh"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^26.6.5",
    "@unocss/astro": "^66.11.0",
    "@unocss/extractor-svelte": "^66.11.0",
    "typescript": "^6.0.3",
    "unocss": "^66.11.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.0",
    "@astrojs/svelte": "^9.1.0",
    "astro": "^7.4.0",
    "svelte": "^5.57.2",
    "zod": "^4.6.7"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    },
    "wrangler": {
      "undici": "7.30.1"
    }
  }
}
