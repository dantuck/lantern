{
  "name": "family-dashboard",
  "type": "module",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "check": "astro check",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply family-dashboard --local",
    "db:migrate:remote": "wrangler d1 migrations apply family-dashboard --remote",
    "verify": "vitest run && astro check && astro build && bash scripts/check-bundle.sh && node scripts/audit.mjs",
    "verify:e2e": "bash scripts/smoke-admin.sh && bash scripts/smoke-plugins.sh && bash scripts/check-csp.sh"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@cloudflare/workers-types": "^5.20261003.1",
    "@types/node": "^26.6.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.147.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/svelte": "^9.0.1",
    "astro": "^7.3.5",
    "svelte": "^5.57.1",
    "zod": "^4.6.5"
  }
}
