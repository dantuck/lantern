---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import Icon from '../components/Icon.astro';
import WallToggle from '../components/WallToggle.astro';
import { registry } from '../plugins/registry';
import { isOn } from '../lib/features';
// `full` lets a page (the calendar) use the whole width of a wall display instead of the usual reading width.
interface Props { title?: string; wide?: boolean; full?: boolean; bare?: boolean; description?: string; demo?: boolean; feature?: string }
const { title = 'Family Dashboard', wide = false, full = false, bare = false, description, demo = false, feature } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : undefined);
// One top-bar link per enabled plugin, so each widget's full page (/p/<id>) is a click away.
const off = Astro.locals.disabled;
const pluginLinks = registry.enabled.filter((p) => isOn(off, p.def.id)).map((p) => ({ href: `/p/${p.def.id}`, label: p.def.name, icon: p.def.icon }));
const demoLinks = [
  { href: '/demo', label: 'Dashboard', icon: 'home' },
  { href: '/demo/calendar', label: 'Calendar', icon: 'calendar', feature: 'calendar' },
  { href: '/demo/chores', label: 'Chores', icon: 'check-circle', feature: 'chores' },
  { href: '/demo/lists', label: 'Lists', icon: 'list', feature: 'lists' },
  { href: '/demo/meals', label: 'Meals', icon: '/icons/mealq.png', feature: 'mealq' },
  { href: '/demo/devices', label: 'Devices', icon: 'smartphone' },
  { href: '/demo/admin', label: 'Admin', icon: 'shield' },
];
const hasRail = demo || !!user;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#c2570a" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Family" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {description && <meta name="description" content={description} />}
    <script is:inline src="/theme-init.js"></script>
    <title>{title}</title>
  </head>
  <body class={hasRail ? 'has-rail' : undefined}>
    {demo && (
      <div class="demo-banner" role="note">
        <span>Demo with sample data. Nothing here is real.</span>
        <a href="/welcome#setup">Get your own</a>
      </div>
    )}
    {demo ? (
      <nav class="nav" aria-label="Demo">
        <a class="brand" href="/demo" aria-label="Demo home"><img src="/favicon.svg" alt="" width="28" height="28" /></a>
        {demoLinks.map((l) => <a href={l.href} aria-current={current(l.href)} data-feature={l.feature}><Icon name={l.icon} /><span>{l.label}</span></a>)}
        <span class="spacer"></span>
        <WallToggle />
        <ThemeToggle />
        <a class="plain-link" href={user ? '/' : '/welcome'}>{user ? 'Exit demo' : 'Back to site'}</a>
      </nav>
    ) : user ? (
      <nav class="nav">
        <a class="brand" href="/" aria-label="Family Dashboard home"><img src="/favicon.svg" alt="" width="28" height="28" /></a>
        <a href="/" aria-current={current('/')}><Icon name="home" /><span>Dashboard</span></a>
        {pluginLinks.map((l) => <a href={l.href} aria-current={current(l.href)}><Icon name={l.icon} /><span>{l.label}</span></a>)}
        {isOn(off, 'chores') && <a href="/chores" aria-current={current('/chores')}><Icon name="check-circle" /><span>Chores</span></a>}
        {isOn(off, 'lists') && <a href="/lists" aria-current={current('/lists')}><Icon name="list" /><span>Lists</span></a>}
        <a href="/devices" aria-current={current('/devices')}><Icon name="smartphone" /><span>Devices</span></a>
        {user.role === 'manager' && <a href="/admin" aria-current={current('/admin')}><Icon name="shield" /><span>Admin</span></a>}
        <span class="spacer"></span>
        <button id="install-app" class="link" type="button" hidden>Install app</button>
        <WallToggle />
        <ThemeToggle />
        <form method="post" action="/auth/logout"><button class="link" type="submit">Sign out</button></form>
      </nav>
    ) : !bare && (
      <div class="theme-float"><ThemeToggle /></div>
    )}
    {hasRail && <WallToggle exit />}
    {bare ? <slot /> : (
      <main class={full ? 'wide full' : wide ? 'wide' : 'narrow-center'} data-feature={feature}>
        {demo && feature && <p class="feature-off notice" data-feature-off={feature}><span>This is switched off in the demo's admin page. <a href="/demo/admin">Turn it back on</a>.</span></p>}
        <slot />
      </main>
    )}
    <script>
      import '../scripts/theme';
      import '../scripts/wall';
      import '../scripts/localtime';
      import '../scripts/pwa';
    </script>
  </body>
</html>
