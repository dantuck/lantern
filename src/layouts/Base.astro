---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import Icon from '../components/Icon.astro';
import WallToggle from '../components/WallToggle.astro';
import { registry } from '../plugins/registry';
import { isOn } from '../lib/features';
// `full` lets a page (the calendar) use the whole width of a wall display instead of the usual reading width.
interface Props { title?: string; wide?: boolean; full?: boolean; bare?: boolean; description?: string; demo?: boolean; feature?: string }
// `wide` / `narrow-center` stay as marker classes: wall mode and the large-screen width in global.css select on them.
const WIDE = 'max-w-[68rem] mx-auto pt-5 pb-12 px-4 sm:pt-8 sm:pb-16 sm:px-6 [&>h1]:mb-4';
const NARROW = 'narrow-center max-w-md mx-auto py-10 px-4 sm:py-16 min-h-[calc(100dvh-8rem)] grid content-center [&>.card]:shadow-[var(--shadow-md)] [&>.card]:p-6 sm:[&>.card]:p-8';
const { title = 'Lantern', wide = false, full = false, bare = false, description, demo = false, feature } = Astro.props;
const user = Astro.locals.user;
const path = Astro.url.pathname;
const current = (href: string) => (path === href ? 'page' : undefined);
// One top-bar link per enabled plugin, so each widget's full page (/p/<id>) is a click away.
const off = Astro.locals.disabled;
const pluginLinks = registry.enabled.filter((p) => isOn(off, p.def.id)).map((p) => ({ href: `/p/${p.def.id}`, label: p.def.name, icon: p.def.icon }));
const demoLinks = [
  { href: '/demo', label: 'Dashboard', icon: 'home' },
  { href: '/demo/calendar', label: 'Calendar', icon: 'calendar', feature: 'calendar' },
  { href: '/demo/chores', label: 'Chores', icon: 'check-circle', feature: 'chores' },
  { href: '/demo/lists', label: 'Lists', icon: 'list', feature: 'lists' },
  { href: '/demo/meals', label: 'Meals', icon: '/icons/mealq.png', feature: 'mealq' },
  { href: '/demo/devices', label: 'Devices', icon: 'smartphone' },
  { href: '/demo/admin', label: 'Admin', icon: 'shield' },
];
// Every destination, in order. The rail (tablet and up) shows them all; the phone's bottom bar shows the first few and puts the rest, plus the utilities, in a "More" sheet.
const items: { href: string; label: string; icon: string; feature?: string }[] = demo
  ? demoLinks
  : user
    ? [
        { href: '/', label: 'Dashboard', icon: 'home' },
        ...pluginLinks,
        ...(isOn(off, 'chores') ? [{ href: '/chores', label: 'Chores', icon: 'check-circle' }] : []),
        ...(isOn(off, 'lists') ? [{ href: '/lists', label: 'Lists', icon: 'list' }] : []),
        { href: '/devices', label: 'Devices', icon: 'smartphone' },
        ...(user.role === 'manager' ? [{ href: '/admin', label: 'Admin', icon: 'shield' }] : []),
      ]
    : [];
// The phone's bottom bar always leads with the daily-use destinations, in a fixed order, so it does not shuffle as widgets are switched on or off.
// If one of them is off, the next widget fills its place. Devices and Admin always live under More.
const TABS = 4;
const PRIMARY = demo ? ['/demo', '/demo/calendar', '/demo/chores', '/demo/lists'] : ['/', '/p/calendar', '/chores', '/lists'];
const ALWAYS_MORE = demo ? ['/demo/devices', '/demo/admin'] : ['/devices', '/admin'];
const picked = PRIMARY.map((h) => items.find((l) => l.href === h)).filter((l): l is (typeof items)[number] => !!l);
const fill = items.filter((l) => !picked.includes(l) && !ALWAYS_MORE.includes(l.href));
const tabs = [...picked, ...fill].slice(0, TABS);
const more = items.filter((l) => !tabs.includes(l));
const moreCurrent = more.some((l) => path === l.href);
const hasRail = demo || !!user;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="theme-color" content="#faf7f3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12100d" media="(prefers-color-scheme: dark)" />
    <meta name="color-scheme" content="light dark" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="Lantern" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {description && <meta name="description" content={description} />}
    <script is:inline src="/theme-init.js"></script>
    <title>{title}</title>
  </head>
  <body class={hasRail ? 'has-rail' : undefined}>
    <a class="skip" href="#main">Skip to content</a>
    {demo && (
      <div class="demo-banner" role="note">
        <span>Demo with sample data. Nothing here is real.</span>
        <a href="/welcome#setup">Get your own</a>
      </div>
    )}
    {hasRail ? (
      <>
        <nav class="nav" aria-label={demo ? 'Demo' : 'Main'}>
          <a class="brand" href={demo ? '/demo' : '/'} aria-label={demo ? 'Demo home' : 'Lantern home'}><img src="/favicon.svg" alt="" width="28" height="28" /></a>
          {items.map((l) => <a href={l.href} aria-current={current(l.href)} data-feature={l.feature}><Icon name={l.icon} /><span>{l.label}</span></a>)}
          <span class="spacer"></span>
          {!demo && <button class="link" data-install-app type="button" hidden>Install app</button>}
          <button class="link" type="button" popovertarget="display-menu" aria-label="Display options"><Icon name="sliders" /><span>Display</span></button>
          {demo
            ? <a class="plain-link" href={user ? '/' : '/welcome'}>{user ? 'Exit demo' : 'Back to site'}</a>
            : <form method="post" action="/auth/logout"><button class="link" type="submit">Sign out</button></form>}
        </nav>

        <div id="display-menu" class="display-menu" popover>
          <p class="dm-label" id="dm-theme">Theme</p>
          <div class="seg" role="group" aria-labelledby="dm-theme">
            <button type="button" data-theme-set="system" aria-pressed="false"><Icon name="monitor" /><span>Auto</span></button>
            <button type="button" data-theme-set="light" aria-pressed="false"><Icon name="sun" /><span>Light</span></button>
            <button type="button" data-theme-set="dark" aria-pressed="false"><Icon name="moon" /><span>Dark</span></button>
          </div>
          <button type="button" class="dm-row" data-wall-toggle aria-pressed="false" popovertarget="display-menu" popovertargetaction="hide"><Icon name="maximize" /><span>Full screen</span></button>
        </div>

        <nav class="tabbar" aria-label={demo ? 'Demo' : 'Main'}>
          {tabs.map((l) => <a href={l.href} aria-current={current(l.href)} data-feature={l.feature}><Icon name={l.icon} /><span>{l.label}</span></a>)}
          <button class="tab" type="button" popovertarget="more" aria-label="More options" aria-current={moreCurrent ? 'page' : undefined}><Icon name="more" /><span>More</span></button>
        </nav>
        <div id="more" class="sheet" popover>
          {more.length > 0 && <div class="sheet-links">{more.map((l) => <a href={l.href} aria-current={current(l.href)} data-feature={l.feature}><Icon name={l.icon} /><span>{l.label}</span></a>)}</div>}
          <div class="sheet-utils">
            <div class="util"><ThemeToggle /><span>Theme</span></div>
            <div class="util"><WallToggle /><span>Full screen</span></div>
            {!demo && <button class="link" data-install-app type="button" hidden>Install app</button>}
            {demo
              ? <a class="plain-link" href={user ? '/' : '/welcome'}>{user ? 'Exit demo' : 'Back to site'}</a>
              : <form method="post" action="/auth/logout"><button class="link" type="submit">Sign out</button></form>}
          </div>
        </div>
      </>
    ) : !bare && (
      <div class="theme-float"><ThemeToggle /></div>
    )}
    {user && !demo && (
      <aside id="install-banner" class="install" aria-label="Install Lantern" hidden>
        <img src="/icons/icon-192.png" alt="" width="40" height="40" />
        <p><strong>Install Lantern</strong><span data-install-copy>Add it to your home screen for quick, full-screen access.</span></p>
        <button class="install-go" type="button" data-install-app hidden>Install</button>
        <span data-install-ios hidden><Icon name="share" /></span>
        <button class="install-x" type="button" data-install-dismiss aria-label="Not now">&times;</button>
      </aside>
    )}
    {hasRail && <WallToggle exit />}
    {bare ? <slot /> : (
      <main id="main" tabindex="-1" class={full ? `wide full ${WIDE} max-w-none` : wide ? `wide ${WIDE}` : NARROW} data-feature={feature}>
        {demo && feature && <p class="feature-off notice" data-feature-off={feature}><span>This is switched off in the demo's admin page. <a href="/demo/admin">Turn it back on</a>.</span></p>}
        <slot />
      </main>
    )}
    <script>
      import '../scripts/theme';
      import '../scripts/wall';
      import '../scripts/localtime';
      import '../scripts/pwa';
      import '../scripts/confirm';
    </script>
  </body>
</html>
