---
import Icon from './Icon.astro';
// Presentational shell shared by the live dashboard (PluginSlot) and the demo pages.
interface Props { id: string; name: string; icon: string; span?: number; href?: string | undefined }
const { id, name, icon, span = 1, href } = Astro.props;
---
<section class={`card plugin ${span === 2 ? 'span-2' : ''}`} data-plugin={id}>
  <header class="plugin-head">
    <h2><Icon name={icon} /> {name}</h2>
    {href && <a href={href} class="muted">Open</a>}
  </header>
  <slot />
</section>
