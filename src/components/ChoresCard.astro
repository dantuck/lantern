---
import { env } from 'cloudflare:workers';
import Icon from './Icon.astro';
import { choreState, type ChoreState } from '../lib/chores';
import { dayKey } from '../lib/dates';
import { householdZone, people as household } from '../lib/household';
import type { Person } from '../lib/people';

// The live dashboard reads D1; the demo passes its own state and people.
interface Props { state?: ChoreState; people?: Person[]; href?: string }
const { state: given, people = household, href = '/chores' } = Astro.props;
let state = given;
if (!state) {
  try { state = await choreState(env.DB, dayKey(Date.now(), householdZone)); }
  catch (e) { console.error('chores card: could not read chores:', e instanceof Error ? e.message : 'unknown'); }
}
const groups = state
  ? [...people.map((p) => ({ name: p.name, color: p.color, items: state!.today.filter((c) => c.person === p.id) })),
     { name: 'Anyone', color: 'var(--accent)', items: state.today.filter((c) => !c.person || !people.some((p) => p.id === c.person)) }].filter((g) => g.items.length > 0)
  : [];
---
<section class="card plugin" data-plugin="chores">
  <header class="plugin-head">
    <h2><Icon name="check-circle" /> Chores today</h2>
    <a href={href} class="muted">Open</a>
  </header>
  {!state ? <p class="muted">Chores couldn't load. Run the database migrations (<code>npm run update</code>).</p>
  : groups.length === 0 ? <p class="muted">No chores today. <a href={href}>Add some</a>.</p>
  : (
    <ul class="mini">
      {groups.map((g) => {
        const done = g.items.filter((i) => i.done).length;
        return (
          <li style={`--c:${g.color}`}>
            <span class="mini-name">{g.name}</span>
            <span class="mini-bar" role="img" aria-label={`${g.name}: ${done} of ${g.items.length} done`}><span style={`width:${(done / g.items.length) * 100}%`}></span></span>
            <span class="mini-n">{done}/{g.items.length}</span>
          </li>
        );
      })}
    </ul>
  )}
</section>
