---
import { env } from 'cloudflare:workers';
import Icon from './Icon.astro';
import { choreState } from '../lib/chores';
import type { ChoreState } from '../lib/choreTypes';
import DashChores from './DashChores.svelte';
import { dayKey } from '../lib/dates';
import { householdZone } from '../lib/household';
import { loadPeople } from '../lib/peopleStore';
import type { Person } from '../lib/people';

// The live dashboard reads D1; the demo passes its own state and people.
interface Props { state?: ChoreState; people?: Person[]; href?: string }
const { state: given, people: givenPeople, href = '/chores' } = Astro.props;
const people = givenPeople ?? (await loadPeople(env.DB));
let state = given;
if (!state) {
  try { state = await choreState(env.DB, dayKey(Date.now(), householdZone), false); }
  catch (e) { console.error('chores card: could not read chores:', e instanceof Error ? e.message : 'unknown'); }
}
---
<section class="card plugin" data-plugin="chores">
  <header class="plugin-head">
    <h2 class="plugin-h2"><Icon name="check-circle" /> Chores today</h2>
    <a href={href} class="plugin-open">Open</a>
  </header>
  {!state ? <p class="muted">Chores couldn't load. Run the database migrations (<code>npm run update</code>).</p>
  : <DashChores client:load initial={state} people={people} href={href} demo={given !== undefined} />}
</section>
