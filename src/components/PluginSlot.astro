---
import { env } from 'cloudflare:workers';
import { loadPluginData } from '../plugins/host';
import type { EnabledPlugin } from '../plugins/registry';
import Time from './Time.astro';
import PluginCard from './PluginCard.astro';

// Convention: src/plugins/<id>/Widget.astro (required) and Page.astro (optional full-page view).
const widgets = import.meta.glob<{ default: any }>('../plugins/*/Widget.astro', { eager: true });
const pages = import.meta.glob<{ default: any }>('../plugins/*/Page.astro', { eager: true });

interface Props { plugin: EnabledPlugin; view?: 'card' | 'page' }
const { plugin, view = 'card' } = Astro.props;
const manager = Astro.locals.user?.role === 'manager';

const result = await loadPluginData(plugin, { env: env as unknown as Record<string, unknown>, kv: env.CACHE });
const id = plugin.def.id;
const View = (view === 'page' ? pages[`../plugins/${id}/Page.astro`] : undefined)?.default ?? widgets[`../plugins/${id}/Widget.astro`]?.default;
---
<PluginCard id={id} name={plugin.def.name} icon={plugin.def.icon} span={plugin.span} href={view === 'card' ? `/p/${id}` : undefined} view={view}>
  {(result.status === 'ok' || result.status === 'stale') && View ? (
    <>
      {result.status === 'stale' && (
        <p class="notice">Showing saved data from <Time ms={result.fetchedAt} />. Live data is unavailable right now.</p>
      )}
      <View data={result.data} config={plugin.config} />
    </>
  ) : result.status === 'unconfigured' ? (
    <p class="muted">This widget isn't set up yet.{manager && <> Missing: <code>{result.missing.join(', ')}</code>.</>}</p>
  ) : (
    <p class="muted">This widget couldn't load. It will retry automatically.</p>
  )}
</PluginCard>
