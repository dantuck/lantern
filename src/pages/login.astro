---
import Base from '../layouts/Base.astro';
const sent = Astro.url.searchParams.get('sent') === '1';
const bad = Astro.url.searchParams.get('bad') === '1';
---
<Base title="Sign in">
  <div class="card">
    <h1>Lantern</h1>
    {sent ? (
      <div class="notice">
        If that address is invited, a sign-in link is on its way. Open the <strong>newest</strong> link in <strong>this same browser</strong>. It expires in 10 minutes.
      </div>
    ) : <p>Enter your email and we'll send you a sign-in link.</p>}
    {sent && (
      <form method="post" action="/auth/code">
        <label for="code">Or enter the code from the email (handy if you read it on another device)</label>
        <input id="code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" required maxlength="12" placeholder="1234 5678" />
        {bad && <p class="hint">That code didn't work. Check the newest email, or send another.</p>}
        <button type="submit">Sign in with code</button>
      </form>
    )}
    <form method="post" action="/auth/request">
      <label for="email">Email</label>
      <input id="email" name="email" type="email" autocomplete="email" required maxlength="254" />
      <button type="submit">{sent ? 'Send another link' : 'Email me a link'}</button>
    </form>
  </div>
  <p class="hint text-center">Just looking? <a href="/demo">Explore the demo</a>.</p>
</Base>
