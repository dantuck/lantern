---
import Base from '../../layouts/Base.astro';
import DemoFeatures from '../../components/DemoFeatures.svelte';
import { demoAudit, demoUsers } from '../../demo/data';
---
<Base title="Admin · Demo" wide demo>
  <h1>Household admin</h1>

  <section class="card">
    <h2>Widgets and features</h2>
    <DemoFeatures client:load />
  </section>

  <section class="card">
    <h2>Invite someone</h2>
    <div class="row">
      <div><label for="inv-email">Email</label><input id="inv-email" type="email" placeholder="name@example.com" disabled /></div>
      <div class="role"><label for="inv-role">Role</label>
        <select id="inv-role" disabled><option>Member (view only)</option><option>Manager (can invite)</option></select></div>
      <button class="demo-off" type="button" disabled title="Not available in the demo">Send invite</button>
    </div>
    <p class="muted hint">Invitations expire after 7 days. The person signs in with a one-time link sent to that address.</p>
  </section>

  <section class="card">
    <h2>Members</h2>
    <table>
      <thead><tr><th>Email</th><th>Role</th><th>Status</th><th>Since</th><th></th></tr></thead>
      <tbody>
        {demoUsers.map((u) => (
          <tr>
            <td>{u.email}</td>
            <td><span class={`badge ${u.role}`}>{u.role}</span></td>
            <td>{u.status === 'disabled' ? <span class="muted">disabled</span> : 'active'}</td>
            <td>{u.since}</td>
            <td><div class="actions">
              <button class="ghost demo-off" type="button" disabled title="Not available in the demo">{u.role === 'manager' ? 'Make member' : 'Make manager'}</button>
              <button class={u.status === 'disabled' ? 'ghost demo-off' : 'danger demo-off'} type="button" disabled title="Not available in the demo">{u.status === 'disabled' ? 'Re-enable' : 'Disable'}</button>
            </div></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="card">
    <h2>Recent activity</h2>
    <table>
      <thead><tr><th>When</th><th>Who</th><th>Event</th><th>Detail</th></tr></thead>
      <tbody>
        {demoAudit.map((a) => (
          <tr><td>{a.when}</td><td>{a.who === 'system' ? <span class="muted">system</span> : a.who}</td><td>{a.event}</td><td class="mono">{a.detail}</td></tr>
        ))}
      </tbody>
    </table>
  </section>
</Base>
