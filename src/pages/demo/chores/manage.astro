---
import Base from '../../../layouts/Base.astro';
import ChoreManager from '../../../components/ChoreManager.svelte';
import { demoChores, demoPeople } from '../../../demo/data';
---
<Base title="Manage chores · Demo" wide demo feature="chores">
  <p data-demo-back><a href="/demo/chores">&larr; Back to chores</a></p>
  <h1>Manage chores</h1>
  <p>This is what a manager sees. Add a routine, change what a chore is worth, add a reward, or approve the request below. In the demo nothing is saved.</p>
  <ChoreManager client:load initial={demoChores()} people={demoPeople} demo />
</Base>
