---
import Base from '../../layouts/Base.astro';
import Time from '../../components/Time.astro';
import { env } from 'cloudflare:workers';
import { listUsers, listPendingInvites } from '../../lib/auth/users';
import { listAllSessions, listAudit } from '../../lib/auth/admin';
import { flashFor } from '../../lib/messages';
import { BUILT_IN_FEATURES, isOn } from '../../lib/features';
import { loadPeople, MAX_PEOPLE } from '../../lib/peopleStore';
import { registry } from '../../plugins/registry';
import { choreCounts } from '../../lib/chores';
import { pendingCount } from '../../lib/rewards';
import { isManager } from '../../lib/http';
import { notifyPrefsFor } from '../../lib/managerNotify';
import { pushKeys } from '../../lib/push';
import ManagerPush from '../../components/ManagerPush.svelte';

// Middleware already limits this path to managers (requiredRole in src/lib/http.ts); check again so the page is safe on its own.
if (!isManager(Astro.locals)) return new Response('Forbidden', { status: 403 });

const me = Astro.locals.user!;
const off = Astro.locals.disabled ?? new Set<string>();
const choresOn = isOn(off, 'chores');
const [users, invites, devices, audit, household, counts, waiting] = await Promise.all([
  listUsers(env.DB), listPendingInvites(env.DB), listAllSessions(env.DB), listAudit(env.DB, 50), loadPeople(env.DB),
  choresOn ? choreCounts(env.DB) : new Map<string, number>(), choresOn ? pendingCount(env.DB, Astro.locals) : 0,
]);
const mine = await notifyPrefsFor(env.DB, me.id);
const pushReady = pushKeys(env) !== null;
const alerts = [
  { kind: 'rewards', label: 'Reward requests', hint: 'When someone asks to spend points.' },
  { kind: 'timers', label: 'Screen time timers', hint: 'When a timer is started, extended or stopped.' },
] as const;
const channels = [{ id: 'email', label: 'Email' }, { id: 'push', label: 'Notification' }] as const;
const flash = flashFor(Astro.url.searchParams.get('msg'));
const currentHash = Astro.locals.session!.idHash;
// Plugins come from dashboard.config.ts (what is installed); managers choose which of them, and which built-ins, are shown.
const features = [
  ...registry.enabled.map((p) => ({ id: p.def.id, name: p.def.name, kind: 'Widget' })),
  ...BUILT_IN_FEATURES.map((f) => ({ id: f.id, name: f.name, kind: 'Built in' })),
];
---
<Base title="Admin" wide>
  <div data-keep-scroll>
  <h1>Household admin</h1>
  {choresOn && (
    <p class="hint-lead">
      <a href="/chores/manage">Manage chores, rewards and points &rarr;</a>
      {waiting > 0 && <> <a class="jump-count" href="/chores/manage#pending-h" title="Reward requests waiting for approval">{waiting} to approve</a></>}
    </p>
  )}
  {flash && <div class={`notice toast ${flash.ok ? '' : 'error'}`} role="status">{flash.text}</div>}

  <nav class="jump" aria-label="Admin sections">
    <a class="jump-link" href="#invite">Invite{invites.length > 0 && <span class="jump-count" title="Pending invitations">{invites.length}</span>}</a>
    <a class="jump-link" href="#members">Members<span class="jump-count">{users.length}</span></a>
    <a class="jump-link" href="#people">People<span class="jump-count">{household.length}</span></a>
    <a class="jump-link" href="#features">Features</a>
    <a class="jump-link" href="#devices">Devices<span class="jump-count">{devices.length}</span></a>
    <a class="jump-link" href="#activity">Activity</a>
  </nav>

  <section class="card" id="invite">
    <h2>Invite someone</h2>
    <form method="post" action="/admin/action" class="row">
      <input type="hidden" name="action" value="invite" />
      <div><label for="inv-email">Email</label><input id="inv-email" name="email" type="email" inputmode="email" required maxlength="254" autocomplete="off" autocapitalize="off" /></div>
      <div class="role"><label for="inv-role">Role</label>
        <select id="inv-role" name="role"><option value="member">Member</option><option value="manager">Manager</option></select></div>
      <button type="submit">Send invite</button>
    </form>
    <p class="text-muted hint"><strong>Members</strong> use the dashboard, tick chores and ask for rewards. <strong>Managers</strong> also invite people, approve rewards and edit everything. Invitations expire after 7 days. A member's email has a one-time Join link that works for 2 days; after that, or for a manager, they sign in with a link emailed to their address.</p>
    {invites.length > 0 && (
      <>
        <h2 class="mt-4">Pending invitations</h2>
        <table class="stack">
          <thead><tr><th>Email</th><th>Role</th><th>Expires</th><th></th></tr></thead>
          <tbody>
            {invites.map((i) => (
              <tr>
                <td class="primary">{i.email}</td><td data-label="Role"><span class="tag">{i.role}</span></td><td data-label="Expires"><Time ms={i.expires_at} /></td>
                <td class="act"><div class="actions"><form method="post" action="/admin/action"><input type="hidden" name="action" value="resend_invite" /><input type="hidden" name="id" value={i.id} /><button class="ghost" type="submit" aria-label={`Send the invitation to ${i.email} again`} data-confirm={`Send a new invitation to ${i.email}? The earlier link stops working.`} data-confirm-label="Send again">Resend</button></form><form method="post" action="/admin/action"><input type="hidden" name="action" value="revoke_invite" /><input type="hidden" name="id" value={i.id} /><button class="ghost" type="submit" aria-label={`Revoke invitation for ${i.email}`} data-confirm={`Revoke the invitation for ${i.email}? The link they were sent will stop working.`}>Revoke</button></form></div></td>
              </tr>
            ))}
          </tbody>
        </table>
      </>
    )}
  </section>

  <section class="card" id="alerts">
    <div class="card-head"><h2>Your alerts</h2></div>
    <table class="stack">
      <thead><tr><th>Tell me when</th>{channels.map((c) => <th>{c.label}</th>)}</tr></thead>
      <tbody>
        {alerts.map((a) => (
          <tr>
            <td class="primary">{a.label}<span class="muted">&nbsp;&middot; {a.hint}</span></td>
            {channels.map((c) => {
              const on = mine[`${a.kind}_${c.id}`];
              return (
                <td data-label={c.label}>
                  {c.id === 'push' && !pushReady ? <span class="muted">Not set up</span> : (
                    <form method="post" action="/admin/action">
                      <input type="hidden" name="action" value="set_notify" /><input type="hidden" name="kind" value={a.kind} /><input type="hidden" name="channel" value={c.id} />
                      <input type="hidden" name="on" value={on ? '0' : '1'} />
                      <button class="ghost" type="submit" aria-pressed={on} aria-label={`${a.label} by ${c.label.toLowerCase()}: ${on ? 'on, turn off' : 'off, turn on'}`}>{on ? 'On' : 'Off'}</button>
                    </form>
                  )}
                </td>
              );
            })}
          </tr>
        ))}
      </tbody>
    </table>
    <p class="text-muted hint">Email goes to {me.email} and needs email to be set up. Notifications go to each device you allow below. You are never told about what you do yourself.</p>
    {pushReady && <ManagerPush client:load />}
  </section>

  <section class="card" id="members">
    <div class="card-head"><h2>Members</h2><span class="text-muted text-[.85rem]">{users.length} {users.length === 1 ? 'person' : 'people'} with a login</span></div>
    <table class="stack">
      <thead><tr><th>Email</th><th>Role</th><th>Status</th><th>Since</th><th></th></tr></thead>
      <tbody>
        {users.map((u) => (
          <tr>
            <td class="primary">{u.email}{u.id === me.id && <span class="muted">&nbsp;(you)</span>}</td>
            <td data-label="Role"><span class={u.role === 'manager' ? 'tag-accent' : 'tag'}>{u.role}</span></td>
            <td data-label="Status">{u.disabledAt ? <span class="status-off">Disabled</span> : <span class="status">Active</span>}</td>
            <td data-label="Since"><Time ms={u.createdAt} /></td>
            <td class="act"><div class="actions">
              {!u.disabledAt && (
                <form method="post" action="/admin/action">
                  <input type="hidden" name="action" value="set_role" /><input type="hidden" name="id" value={u.id} />
                  <input type="hidden" name="role" value={u.role === 'manager' ? 'member' : 'manager'} />
                  <button class="ghost" type="submit" data-confirm={u.role === 'manager' ? `Make ${u.email} a member? They will lose access to this page.` : undefined} aria-label={`${u.role === 'manager' ? 'Make member' : 'Make manager'}: ${u.email}`}>{u.role === 'manager' ? 'Make member' : 'Make manager'}</button>
                </form>
              )}
              {u.id !== me.id && <form method="post" action="/admin/action">
                <input type="hidden" name="action" value="set_disabled" /><input type="hidden" name="id" value={u.id} />
                <input type="hidden" name="disabled" value={u.disabledAt ? '0' : '1'} />
                <button class={u.disabledAt ? 'ghost' : 'danger'} type="submit" aria-label={`${u.disabledAt ? 'Re-enable' : 'Disable'}: ${u.email}`} data-confirm={u.disabledAt ? undefined : `Disable ${u.email}? They are signed out everywhere and cannot sign in until re-enabled.`}>{u.disabledAt ? 'Re-enable' : 'Disable'}</button>
              </form>}
            </div></td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <section class="card" id="people">
    <div class="card-head"><h2>People</h2><span class="text-muted text-[.85rem]">{household.length} of {MAX_PEOPLE}</span></div>
    <p class="text-muted hint-lead">The kids and adults who get a colour on the calendar and a column on the Chores page. A person is just a name; they do not need a login. Each person's chores are set under <a href="/chores/manage">Manage chores</a>. Changes to a row save as soon as you leave a field.</p>
    <div class="people-list">
      {household.map((p) => { const count = counts.get(p.id) ?? 0; return (
        <div class="person-box">
          <form method="post" action="/admin/action" class="person-row" data-autosave>
            <input type="hidden" name="action" value="person_save" /><input type="hidden" name="id" value={p.id} />
            <div><label for={`pn-${p.id}`}>Name</label><input id={`pn-${p.id}`} name="name" value={p.name} required maxlength="30" /></div>
            <div class="color"><label for={`pc-${p.id}`}>Colour</label><input id={`pc-${p.id}`} name="color" type="color" value={p.color} /></div>
            <div><label for={`pm-${p.id}`}>Calendar words</label><input id={`pm-${p.id}`} name="match" value={p.match.join(', ')} maxlength="200" /></div>
            <div class="btns">
              <span class="note self-center flex-1">{count} {count === 1 ? 'chore' : 'chores'}{choresOn && <> · <a href="/chores/manage">Manage</a></>}</span>
              <button class="ghost" type="submit">Save</button>
              <button class="danger" type="submit" name="action" value="person_remove" formnovalidate aria-label={`Remove ${p.name}`} data-confirm={`Remove ${p.name}? Their chore lists are kept and move to Anyone.`}>Remove</button>
            </div>
          </form>
        </div>
      ); })}
      {household.length < MAX_PEOPLE && (
        <div class="person-box-new">
          <form method="post" action="/admin/action" class="person-row">
            <input type="hidden" name="action" value="person_save" />
            <div><label for="pn-new">Add a person</label><input id="pn-new" name="name" required maxlength="30" autocomplete="off" placeholder="Name" /></div>
            <div class="color"><label for="pc-new">Colour</label><input id="pc-new" name="color" type="color" value="#1c7ed6" /></div>
            <div><label for="pm-new">Calendar words</label><input id="pm-new" name="match" maxlength="200" placeholder="optional, comma separated" /></div>
            <div class="btns"><button type="submit">Add person</button></div>
          </form>
        </div>
      )}
    </div>
    <p class="text-muted hint">Calendar words put an event on someone's calendar when they appear in its title, such as a nickname. The name itself always counts. Removing someone keeps their chore lists, which then show under Anyone.</p>
  </section>

  <section class="card" id="features">
    <h2>Widgets and features</h2>
    <table class="stack">
      <thead><tr><th>Name</th><th>Type</th><th>Status</th><th></th></tr></thead>
      <tbody>
        {features.map((f) => (
          <tr>
            <td class="primary">{f.name}</td>
            <td data-label="Type"><span class="tag">{f.kind}</span></td>
            <td data-label="Status">{off.has(f.id) ? <span class="status-off">Off</span> : <span class="status">On</span>}</td>
            <td class="act"><div class="actions"><form method="post" action="/admin/action">
              <input type="hidden" name="action" value="set_feature" /><input type="hidden" name="id" value={f.id} />
              <input type="hidden" name="enabled" value={off.has(f.id) ? '1' : '0'} />
              <button class={off.has(f.id) ? 'ghost' : 'danger'} type="submit" aria-label={`${off.has(f.id) ? 'Turn on' : 'Turn off'} ${f.name}`} data-confirm={off.has(f.id) ? undefined : `Turn off ${f.name}? It is hidden from everyone; its data is kept.`}>{off.has(f.id) ? 'Turn on' : 'Turn off'}</button>
            </form></div></td>
          </tr>
        ))}
      </tbody>
    </table>
    <p class="text-muted hint">Turning something off hides it from everyone; its data is kept. Which widgets exist at all is set in <code>dashboard.config.ts</code>.</p>
  </section>

  <details class="card group" id="devices">
    <summary class="card-summary"><h2>Signed-in devices</h2><span class="text-muted">{devices.length}</span></summary>
    <table class="stack">
      <thead><tr><th>Person</th><th>Device</th><th>Last active</th><th></th></tr></thead>
      <tbody>
        {devices.map((d) => (
          <tr>
            <td class="primary">{d.email}</td>
            <td data-label="Device">{d.deviceLabel}{d.idHash === currentHash && <span class="muted">&nbsp;(this device)</span>}</td>
            <td data-label="Last active"><Time ms={d.lastSeen} /></td>
            <td class="act"><form method="post" action="/admin/action"><input type="hidden" name="action" value="revoke_session" /><input type="hidden" name="id" value={d.idHash} /><button class="ghost" type="submit" aria-label={`Sign out ${d.deviceLabel} (${d.email})`} data-confirm={`Sign out ${d.deviceLabel} (${d.email})? It needs a fresh email link to get back in.`}>Sign out</button></form></td>
          </tr>
        ))}
      </tbody>
    </table>
  </details>

  <details class="card group" id="activity">
    <summary class="card-summary"><h2>Recent activity</h2><span class="text-muted">last {audit.length}</span></summary>
    <label class="cap-field mb-3">Filter <input type="search" data-filter="#activity-rows" placeholder="Event, person or detail" autocomplete="off" /></label>
    <table class="stack">
      <thead><tr><th>When</th><th>Who</th><th>Event</th><th>Detail</th></tr></thead>
      <tbody id="activity-rows">
        {audit.map((a) => (
          <tr><td class="primary"><Time ms={a.at} /></td><td data-label="Who">{a.actorEmail ?? <span class="muted">system</span>}</td><td data-label="Event">{a.event}</td><td data-label="Detail" class="mono">{a.detail}</td></tr>
        ))}
      </tbody>
    </table>
  </details>
  </div>
  <script>
    // A person's row saves when you change a field (the browser only fires `change` when the value differs), so editing two rows never loses the first one.
    for (const form of document.querySelectorAll<HTMLFormElement>('form[data-autosave]')) {
      form.addEventListener('change', () => { if (form.checkValidity()) form.requestSubmit(); });
    }
    // The activity filter hides rows that do not contain the text.
    document.querySelector<HTMLInputElement>('input[data-filter]')?.addEventListener('input', (e) => {
      const q = (e.currentTarget as HTMLInputElement).value.trim().toLowerCase();
      for (const row of document.querySelectorAll<HTMLElement>('#activity-rows tr')) row.hidden = !!q && !row.textContent!.toLowerCase().includes(q);
    });
  </script>
</Base>
