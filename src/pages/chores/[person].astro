---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import PersonChores from '../../components/PersonChores.svelte';
import { choreState } from '../../lib/chores';
import { dayKey } from '../../lib/dates';
import { householdZone } from '../../lib/household';
import { loadPeople } from '../../lib/peopleStore';
import { isOn } from '../../lib/features';
import { isManager } from '../../lib/http';

if (!isOn(Astro.locals.disabled, 'chores')) return new Response('Not found', { status: 404 });

const [state, people] = await Promise.all([choreState(env.DB, dayKey(Date.now(), householdZone), isManager(Astro.locals)), loadPeople(env.DB)]);
const who = people.find((p) => p.id === Astro.params.person);
if (!who) return new Response('Not found', { status: 404 });
---
<Base title={`${who.name} · Chores`} wide>
  <PersonChores client:load initial={state} people={people} who={who.id} />
</Base>
