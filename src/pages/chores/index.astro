---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import Chores from '../../components/Chores.svelte';
import { choreState } from '../../lib/chores';
import { dayKey, formatDay } from '../../lib/dates';
import { householdZone } from '../../lib/household';
import { loadPeople } from '../../lib/peopleStore';
import { isOn } from '../../lib/features';
import { isManager } from '../../lib/http';

if (!isOn(Astro.locals.disabled, 'chores')) return new Response('Not found', { status: 404 });

const day = dayKey(Date.now(), householdZone);
const [state, people] = await Promise.all([choreState(env.DB, day, isManager(Astro.locals)), loadPeople(env.DB)]);
---
<Base title="Chores" wide>
  <Chores client:load initial={state} people={people} intro={`${formatDay(day, { weekday: 'long', month: 'long', day: 'numeric' })}. Ticks reset each morning.`} />
</Base>
