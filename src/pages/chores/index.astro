---
import { env } from 'cloudflare:workers';
import Base from '../../layouts/Base.astro';
import Chores from '../../components/Chores.svelte';
import { choreState } from '../../lib/chores';
import { dayKey, formatDay } from '../../lib/dates';
import { householdZone, people } from '../../lib/household';
import { isOn } from '../../lib/features';
import { isManager } from '../../lib/http';

if (!isOn(Astro.locals.disabled, 'chores')) return new Response('Not found', { status: 404 });

const day = dayKey(Date.now(), householdZone);
const state = await choreState(env.DB, day, isManager(Astro.locals));
---
<Base title="Chores" wide>
  <h1>Chores</h1>
  <p>{formatDay(day, { weekday: 'long', month: 'long', day: 'numeric' })}. Ticks reset each morning.</p>
  <Chores client:load initial={state} people={people} />
</Base>
