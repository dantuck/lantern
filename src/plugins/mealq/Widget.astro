---
import { dayKey, dayLabel } from '../../lib/dates';
import type { MealQConfig } from './plugin';
import type { Meal, MealPlanData } from './client';
import { SLOT_COLOR, SLOT_LABEL } from './slots';

interface Props { data: MealPlanData; config: MealQConfig }
const { data, config } = Astro.props;
const today = dayKey(Date.now(), config.timeZone);
// The cache can be minutes old, so drop days that have already passed.
const days = data.days.filter((d) => d.date >= today);
const hasDetails = (m: Meal) => Boolean(m.ingredients?.length || m.prepMinutes || m.recipeUrl);
const planned = days.some((d) => d.meals.length > 0);
---
{!planned ? (
  <p class="text-muted">No meals planned for the next {config.daysAhead} days.</p>
) : (
  <div class="meal-days">
    {days.map((day) => {
      const expandable = day.meals.some(hasDetails);
      const Tag = expandable ? 'details' : 'section';
      const Head = expandable ? 'summary' : 'div';
      return (
        <Tag class:list={['meal-day', day.meals.length === 0 ? 'bg-transparent border-dashed' : day.date === today ? 'bg-accent-soft' : 'bg-card2', day.date === today ? '[border-color:color-mix(in_srgb,var(--accent)_40%,var(--border))]' : 'border-line', expandable && 'group']}>
          <Head class:list={['meal-head', expandable && 'meal-chev']}>
            <h3 class:list={['m-0 mb-[.6rem] text-[.72rem] font-bold uppercase tracking-[.07em]', day.date === today ? 'text-accent' : 'text-muted']}>{dayLabel(day.date, today, config.locale)}</h3>
            {day.meals.length === 0 ? (
              <p class="m-0 text-[.9rem]">Nothing planned</p>
            ) : (
              <ul class="meal-ul">
                {day.meals.map((m) => (
                  <li style={`--c:${SLOT_COLOR[m.slot]}`}>
                    <span class="meal-slot">{SLOT_LABEL[m.slot]}</span>
                    <span class="font-semibold leading-[1.3] [overflow-wrap:anywhere]">{m.title}</span>
                    {m.note && <span class="text-[.85rem] text-muted [overflow-wrap:anywhere]">{m.note}</span>}
                  </li>
                ))}
              </ul>
            )}
          </Head>
          {expandable && (
            <div class="mt-[.9rem] pt-[.9rem] [border-top:1px_solid_var(--border)] grid gap-4">
              {day.meals.filter(hasDetails).map((m) => (
                <section data-slot={m.slot}>
                  <h4 class="m-0 mb-1 text-[.9rem]">{m.title}</h4>
                  {m.prepMinutes && <p class="m-0 mb-[.35rem] text-[.9rem] text-muted">Prep time: {m.prepMinutes} min</p>}
                  {m.ingredients && (
                    <ul class="meal-ingredients">{m.ingredients.map((i) => <li>{i}</li>)}</ul>
                  )}
                  {m.recipeUrl && <a class="text-[.88rem] font-semibold" href={m.recipeUrl} target="_blank" rel="noopener noreferrer">Open recipe</a>}
                </section>
              ))}
            </div>
          )}
        </Tag>
      );
    })}
  </div>
)}
