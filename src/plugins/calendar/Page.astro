---
import CalendarView from './CalendarView.svelte';
import { env } from 'cloudflare:workers';
import { loadPeople } from '../../lib/peopleStore';
import type { Person } from '../../lib/people';
import type { CalendarViewConfig } from './plugin';
import type { CalendarData } from './types';

// `people` is only passed by the demo, which has its own invented household.
interface Props { data: CalendarData; config: CalendarViewConfig; people?: Person[] }
const { data, config, people: givenPeople } = Astro.props;
const people = givenPeople ?? (await loadPeople(env.DB));
---
<CalendarView
  client:load
  events={data.events}
  timeZone={config.timeZone}
  locale={config.locale}
  nowMs={Date.now()}
  windowStart={data.windowStart}
  windowEnd={data.windowEnd}
  people={people}
  weather={data.weather}
  meals={data.meals}
  mealSlots={config.meals?.slots}
/>
