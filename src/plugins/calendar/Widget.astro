---
import { dayKey, dayLabel, formatTime } from '../../lib/dates';
import { groupByDay } from './agenda';
import { env } from 'cloudflare:workers';
import { loadPeople } from '../../lib/peopleStore';
import { peopleOf, type Person } from '../../lib/people';
import type { CalendarViewConfig } from './plugin';
import type { CalendarData } from './types';

interface Props { data: CalendarData; config: CalendarViewConfig; moreHref?: string; people?: Person[] }
const { data, config, moreHref = '/p/calendar', people: givenPeople } = Astro.props;
const people = givenPeople ?? (await loadPeople(env.DB));
const colorOf = (title: string) => (people.length ? (peopleOf(title, people)[0]?.color ?? 'var(--accent)') : undefined);
const { timeZone, locale } = config;

const today = dayKey(Date.now(), timeZone);
const days = groupByDay(data.events, timeZone, today, 7).filter((d) => d.events.length > 0);
const LIMIT = 10;
let shown = 0;
const total = days.reduce((n, d) => n + d.events.length, 0);
---
{days.length === 0 ? (
  <p class="text-muted">Nothing scheduled in the next 7 days.</p>
) : (
  <div>
    {days.map((day) => {
      const rows = day.events.slice(0, Math.max(0, LIMIT - shown));
      shown += rows.length;
      return rows.length > 0 && (
        <section class="agenda-day">
          <h3 class="m-0 mb-[.4rem] text-[.72rem] [font-weight:650] uppercase tracking-[.07em] text-muted">{dayLabel(day.key, today, locale)}</h3>
          <ul class="list-none m-0 p-0">
            {rows.map((ev) => (
              <li class:list={['agenda-li', people.length && 'agenda-li-tinted']} style={colorOf(ev.title) ? `--c:${colorOf(ev.title)}` : undefined}>
                <span class="text-muted min-w-20 text-[.88rem] tabular-nums pt-[.05rem]">{ev.allDay ? 'All day' : formatTime(ev.start, timeZone, locale)}</span>
                <span class="font-medium min-w-0 [overflow-wrap:anywhere]">{ev.title}{ev.location && <span class="text-muted font-normal"> · {ev.location}</span>}</span>
              </li>
            ))}
          </ul>
        </section>
      );
    })}
    {total > LIMIT && <p class="text-muted"><a href={moreHref}>+{total - LIMIT} more</a></p>}
  </div>
)}
